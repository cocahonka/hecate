{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter: Debug",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}",
            "env": {
                "PUB_HOSTED_URL": "https://pub.dev"
            }
        },
        {
            "name": "Dart: Run bin",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/bin/main.dart",
            "console": "terminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PUB_HOSTED_URL": "https://pub.dev"
            }
        }
    ]
}